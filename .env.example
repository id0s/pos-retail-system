# .env Example - Copy ke .env dan sesuaikan

CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false
app.sessionDriver = 'FileHandler'
app.sessionCookieName = 'PHPSESSID'
app.sessionExpiration = 7200
app.sessionSavePath = null
app.CSRFProtection = true
app.CSRFTokenName = 'csrf_test_name'
app.CSRFHeaderName = 'X-CSRF-TOKEN'
app.CSRFCookieName = 'csrf_cookie_name'
app.CSRFExpire = 7200
app.CSRFRegenerate = true
app.CSRFExcludeURIs = []
app.reduceSSLDisabledWarnings = true

# Database Configuration
database.default.hostname = localhost
database.default.database = pos_retail
database.default.username = root
database.default.password = 
database.default.DBDriver = MySQLi
database.default.DBPrefix = 
database.default.port = 3306

# Encryption
encryption.default = OpenSSL
encryption.openssl.key = 
encryption.openssl.driver = OpenSSL

# Midtrans Payment Gateway
midtrans.server_key = YOUR_MIDTRANS_SERVER_KEY
midtrans.client_key = YOUR_MIDTRANS_CLIENT_KEY
midtrans.is_production = false

# App Settings
app.app_name = 'POS Retail Management System'
app.app_version = '1.0.0'
app.timezone = 'Asia/Jakarta'
